# ── 커리어++ 백엔드 (Go) ── 저장소 루트의 .env. 서버: pm2(ecosystem.config.cjs)가 읽는다
# 웹(Vite) 값은 web/.env (web/.env.example)

# Caddy 뒤에서는 127.0.0.1 의 이 포트로 뜬다 (ae2p Caddyfile 의 /api/career/* → 127.0.0.1:8092)
HOST=127.0.0.1
PORT=8092
# 로컬 개발(Vite 개발 서버)에서만 필요. 배포는 같은 도메인이라 CORS 가 필요 없다
ALLOW_ORIGIN=http://localhost:5173
# 알림 메일에 넣는 사이트 주소
PUBLIC_URL=https://ae2p.duckdns.org

# ── 로그인 (ae:p 포털 · Supabase Auth) ── 토큰 검증용 공개키(JWKS)를 여기서 받는다
SUPABASE_URL=https://xxxxxxxx.supabase.co

# ── DB: 공용 Supabase 의 career 스키마 ── 운동기록과 같은 Session pooler 문자열
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# 무료 플랜은 동시 연결 한도가 작다 (업무일지·포털·운동기록과 나눠 쓴다)
DB_MAX_CONNS=3
DB_QUERY_MODE=

# ── job++ ── 사람인 Open API 접근 키 (https://oapi.saramin.co.kr 에서 신청). 비우면 사람인은 검색 링크만
SARAMIN_ACCESS_KEY=

# ── contact: 메일 알림 (SMTP) ── Supabase 초대 메일에 쓰는 SMTP(Gmail 앱 비밀번호 등)를 같이 써도 된다
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM="커리어++ <you@gmail.com>"

# ── contact: 문자 알림 (솔라피 https://solapi.com) ── 비우면 문자 알림은 꺼진다
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 솔라피 콘솔에 등록한 발신번호 (하이픈 없이)
SMS_FROM=
# 하루 문자 알림 상한 (요금 보호)
SMS_DAILY_LIMIT=20
# 방문자 IP 당 연락 폼 허용 횟수 (1시간)
CONTACT_PER_HOUR=5
